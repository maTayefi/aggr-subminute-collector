# Private Hugging Face Dataset archive.
AGGR_COLLECTOR_HF_REPO_ID=maTayefi/smp-aggr-subminute
AGGR_COLLECTOR_HF_REPO_TYPE=dataset
AGGR_COLLECTOR_HF_REVISION=main

# Local development only.
# GitHub Actions will map its HF_TOKEN secret to this variable.
AGGR_COLLECTOR_HF_TOKEN=

# Collector behavior.
AGGR_COLLECTOR_WORK_DIR=.collector_work
AGGR_COLLECTOR_ROLLING_REFETCH_HOURS=3
AGGR_COLLECTOR_RETENTION_DAYS=90

# Do not archive aggr-server's still-changing recent pending bars.
AGGR_COLLECTOR_SOURCE_FINALIZATION_LAG_SECONDS=60

AGGR_COLLECTOR_REQUEST_TIMEOUT_SECONDS=30
AGGR_COLLECTOR_REQUEST_MAX_ATTEMPTS=4
AGGR_COLLECTOR_REQUEST_INITIAL_BACKOFF_SECONDS=1

# Safe Hugging Face read retries. These apply to revision discovery, listing,
# and immutable-revision downloads. Atomic writes are not blindly retried.
AGGR_COLLECTOR_HF_READ_MAX_ATTEMPTS=4
AGGR_COLLECTOR_HF_READ_INITIAL_BACKOFF_SECONDS=1